# Copy variable names into your local shell or an ignored .env file.
DB_URL=jdbc:postgresql://localhost:9543/db_oauth2
DB_USERNAME=iteuser
DB_PASSWORD=replace-me
IAM_ISSUER=http://localhost:9000
IAM_DCR_CLIENT_SECRET=replace-with-a-long-random-secret
# Optional for local development; configure both PEM paths in persistent deployments.
IAM_JWK_PRIVATE_KEY_PATH=
IAM_JWK_PUBLIC_KEY_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
